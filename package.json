{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "test:ui": "playwright test --config=tests/ui/playwright.config.mjs",
    "media:thumbnails": "node scripts/generate-project-thumbnails.mjs",
    "media:export": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-project-media.ps1",
    "media:optimize": "node scripts/optimize-site-media.mjs",
    "check:budget": "node scripts/check-performance-budget.mjs",
    "check": "npm run lint && npm test && npm run build && npm run check:budget"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.1.2",
    "canvas-confetti": "^1.9.3",
    "maath": "^0.10.8",
    "motion": "^12.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-responsive": "^10.0.1",
    "tailwind-merge": "^3.3.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "sharp": "^0.35.5",
    "vite": "^6.3.5",
    "@tailwindcss/vite": "^4.1.8",
    "tailwindcss": "^4.1.8",
    "eslint-plugin-react": "^7.37.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
